    "check:mcp:live": "node scripts/probe-mcp.mjs --live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "next": "14.2.33",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "^5.5.0"
  }
}
