{
  "name": "ppt-anything-web",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-config PPT generation via image generation, driven by your local Codex agent.",
  "scripts": {
    "dev": "next dev -p 4311",
    "build": "next build",
    "start": "next start -p 4311",
